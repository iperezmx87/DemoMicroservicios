<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Confluent.Kafka" Version="2.14.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
		<PackageReference Include="MongoDB.Driver" Version="3.1.0" />
	</ItemGroup>

	<!-- Configuración de empaquetado para docker -->
	<PropertyGroup>
		<RootNamespace>Isra.Demos.EventStore</RootNamespace>
		<ContainerRepository>pesimx87/isra-microservicios-eventstore</ContainerRepository>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Isra.Demos.EventSource.Models\Isra.Demos.EventSource.Models.csproj" />
	</ItemGroup>

</Project>
